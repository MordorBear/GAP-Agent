# SAM.gov Contract Fetching Agent - environment configuration
# Copy this file to ".env" and fill in your API key.

# REQUIRED: Your personal SAM.gov API key.
# Get one free at https://sam.gov/profile/details  ->  "System Accounts" -> "API Key"
SAM_GOV_API_KEY=your_api_key_here

# OPTIONAL overrides (defaults shown). Command-line flags take precedence.
# SAM_MIN_VALUE=10000
# SAM_INCLUDE_UNKNOWN_VALUE=true
# SAM_ACTIVE_ONLY=true
# SAM_LOOKBACK_DAYS=364
# By default a dated report is written to results/results-MM-DD-YYYY.html.
# SAM_RESULTS_DIR=results
# SAM_OUTPUT_FILE=   # set to override the full output path
# Auto-commit each generated report to git (set to false to disable).
# SAM_AUTO_COMMIT=true
